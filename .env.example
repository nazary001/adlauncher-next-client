# adlauncher — environment (server-side only unless NEXT_PUBLIC_*). Copy to .env.local for local dev.
# Values are never committed. Vercel: Project → Settings → Environment Variables (Production + Preview).

# ---- data store (MongoDB Atlas, cluster gc-prod, eu-central-1) — replaces every STRAPI_* var -----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=gc-prod
MONGODB_DB=gc
# optional tuning: MONGODB_POOL=10  MONGODB_APP_NAME=adlauncher

# ---- login fallback while the old tools Strapi is still up (lazy password migration, lib/auth-users) ---
# A migrated user has no bcrypt hash yet; the first login is verified here and the hash is stored.
# Remove once every user has logged in once or has been given a password (npm run set-password).
STRAPI_TOOLS_URL=https://efficient-broccoli-73345f1265.strapiapp.com

# ---- sessions / roles --------------------------------------------------------------------------------
AUTH_SECRET=<32+ random chars — HMAC key of the adl_session cookie>
# ADL_OWNER_ROLES=owner,admin
# ADL_OWNER_USERS=<comma-separated usernames granted owner regardless of app_role>
CRON_SECRET=<bearer for /api/hs/token-cron>

# ---- creative store (our S3 bucket — owner ask 08.10: stop moving media through Vercel Blob) ----------
# Creatives upload browser → S3 (presigned) at attach time; the server fetches image bytes / hands
# Meta the public URL. Set up the bucket once with scripts/creatives-bucket-setup.mjs.
CREATIVES_S3_BUCKET=gc-adlauncher-creatives
CREATIVES_S3_REGION=eu-central-1
CREATIVES_S3_ACCESS_KEY_ID=
CREATIVES_S3_SECRET_ACCESS_KEY=
# optional: a CDN origin creative URLs are built on (else the bucket's own origin)
# CREATIVES_PUBLIC_BASE=
# optional: sign uploads for the S3 Transfer Acceleration endpoint
# CREATIVES_S3_ACCELERATE=1

# ---- media staging (Vercel Blob) — LEGACY, kept for one release -----------------------------------
# Only /api/blob-upload and the launch routes' del() of pre-S3-deploy tabs still use it. Remove once
# every open tab has reloaded onto the S3 creative store.
BLOB_READ_WRITE_TOKEN=

# ---- Meta video reuse / head start (spec §4.6) -------------------------------------------------------
# A content-addressed video already registered in the same ad account is reused within this window
# (hours); 0 switches reuse off. Default 12.
FB_VIDEO_REUSE_HOURS=12

# ---- server-side launch queue ------------------------------------------------------------------------
# Origin the pump kicks its own continuation on; falls back to the request origin / the Vercel
# production URL. Set it only when the inferred origin is wrong (e.g. behind a custom proxy).
# ADL_SELF_ORIGIN=

# ---- local end-to-end only: a loopback Graph (NEVER used in production or for a non-loopback host) ----
# When set to a 127.0.0.1/localhost http origin AND VERCEL_ENV != production, Graph calls hit it
# instead of graph.facebook.com (local mock). Ignored otherwise.
# FB_GRAPH_BASE=http://127.0.0.1:8900

# ---- Facebook tokens (seeds; the live registry lives in app_caches "fb-token-registry:v1") ------------
FB_LAUNCH_TOKEN=
FB_AIF_LAUNCH_TOKEN=
FB_HS_LAUNCH_TOKEN=
FB_HS_LAUNCH_TOKEN_2=
FB_HS_LAUNCH_TOKEN_3=
FB_HS_LAUNCH_TOKEN_4=
FB_HS_DUP_TOKEN=
FB_HS_VOLUME_TOKEN=
FB_HS_VOLUME_TOKEN_FARM=
FB_MO_SOC_TOKENS=

# ---- LION (HS partner weapons) ------------------------------------------------------------------------
LION_BASE=
LION_TOKEN=
LION_ACR=
HS_PAGES_API_URL=
HS_PAGES_API_KEY=
TOOL_SESSIONS_API_KEY=

# ---- Snapchat ----------------------------------------------------------------------------------------
NEXT_PUBLIC_SNAP_ENABLED=0
SNAP_API_BASE=
SNAP_AUTH_BASE=
SNAP_BUSINESS_API_BASE=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REFRESH_TOKEN=
SNAP_OAUTH_REDIRECT_URI=
SNAP_ORGANIZATION_ID=
SNAP_PROFILE_ID=
SNAP_PROFILE_NAME=
SNAP_BRAND_NAME=
SNAP_PIXEL_ID=
SNAP_CAPI_EVENTS_URL=
SNAP_CAPI_TOKEN=

# ---- rails / partners ---------------------------------------------------------------------------------
NEXT_PUBLIC_AIF_ENABLED=0
NEXT_PUBLIC_GOOGLE_ENABLED=0
NEXT_PUBLIC_HS_ENABLED=0
NEXT_PUBLIC_TIKTOK_ENABLED=0
AV_API_KEY=
GEMINI_API_KEY=
